{
  "name": "backstab-desktop",
  "version": "1.0.0",
  "description": "Desktop wrapper for BackStab",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "dev": "electron .",
    "build:frontend": "npm --prefix ../front-end run build",
    "build:desktop": "electron-builder --mac --x64",
    "build:mac:x64": "npm run build:frontend && npm run build:desktop"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.backstab.desktop",
    "productName": "BackStab",
    "files": [
      "src/**/*"
    ],
    "extraResources": [
      {
        "from": "../front-end/dist",
        "to": "frontend-dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/db.sqlite3",
          "!**/sample_files/**"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    }
  }
}
